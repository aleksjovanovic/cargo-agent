# Server
SERVER_PORT=8081
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=info                   # debug | info | warn | error

# Database (PostgreSQL example)
DATABASE_URL=postgres://cargo_user:changeMeStrong@localhost:5432/cargo_agent?sslmode=disable

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=                   # leave empty if no password

# Auth (JWT)
# Use a strong, at least 32-byte secret. Example below is placeholder.
JWT_SECRET_KEY=supersecret_supersecret_supersecret_32b

# Admin users
ADMIN_USER_IDS = 1,3,5,7

# SMTP / Mailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=changeMeStrongPassword
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Cargo Agent
SMTP_ENCRYPTION=STARTTLS           # STARTTLS | TLS | NONE
SMTP_TIMEOUT=10s                   # Go duration (e.g., 5s, 10s, 1m)
SMTP_TLS_INSECURE_SKIP_VERIFY=false

# Email verification
EMAIL_VERIFICATION_TTL=24h
EMAIL_VERIFY_BASE=http://localhost:${SERVER_PORT}/cargo-agent/v1/users/verify-email

PASSWORD_RESET_TTL=1h
PASSWORD_RESET_BASE=http://localhost:${SERVER_PORT}/cargo-agent/v1/users/password-reset/confirm